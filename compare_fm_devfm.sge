#!/bin/bash
#$ -N blimp-fm-vs-dev
#$ -cwd
#$ -q cuda.q
#$ -S /bin/bash
#$ -o logs
#$ -e logs
#$ -M YOUR_MPI_EMAIL
#$ -m bea

module purge
unset PYTHONHOME
unset PYTHONPATH

module load python/3.9.4
module load gcc/11.4.0

source /home/andsch1/.venvs/babylm-eval/bin/activate

export PYTHONPATH=/usr/shared/apps/python/python-3.9.4/lib/python3.9:/usr/shared/apps/python/python-3.9.4/lib64/python3.9:/usr/shared/apps/python/python-3.9.4/lib64/python3.9/lib-dynload

cd /home/andsch1/evaluation-pipeline-2023

echo "Job $JOB_ID started at $(date)"
echo "Running on $(hostname)"
python --version

python -u compare_fm_devfm.py

echo "Job $JOB_ID finished at $(date)"